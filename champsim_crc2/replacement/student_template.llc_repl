// ============================================
// Find replacement victim
// Called when a cache miss occurs and we need to evict a line
//
// Parameters:
//   cpu        - CPU that initiated the access (0 to NUM_CPUS-1)
//   set        - Cache set index
//   current_set- Array of BLOCK structs for this set (size: LLC_WAYS)
//                Each BLOCK has: valid, dirty, address, full_addr, tag, data, cpu, lru
//   PC         - Program counter (instruction pointer) that caused the miss
//   paddr      - Physical address being accessed
//   type       - Access type: LOAD, RFO, PREFETCH, or WRITEBACK
//
// Return value:
//   Way number (0 to LLC_WAYS-1) of the victim to evict
//   Return LLC_WAYS to bypass the cache (not fill)
// ============================================
uint32_t GetVictimInSet(uint32_t cpu, uint32_t set, const BLOCK *current_set,
                        uint64_t PC, uint64_t paddr, uint32_t type) {
    // TODO: Implement your victim selection algorithm

    // Example: Return first invalid line if available
    for (uint32_t i = 0; i < LLC_WAYS; i++) {
        if (!current_set[i].valid) {
            return i;
        }
    }

    // Example: Simple LRU-like behavior (return way 0)
    // Replace this with your algorithm
    return 0;
}

// ============================================
